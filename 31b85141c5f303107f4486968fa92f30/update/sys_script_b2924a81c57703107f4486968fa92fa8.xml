        <script><![CDATA[(function executeRule(current, previous) {
    if (current.received.changesFrom(false)) { // only when Received becomes true
        var vendorId = current.vendor_request.sys_id;
        var result = new VendorRiskUtils().calculateRiskScore(vendorId);
        var parsed = JSON.parse(result);
        var gr = new GlideRecord('x_vendor_onboarding_vendor_request');
        if (gr.get(vendorId)) {
            gr.risk_score = parsed.score;
            gr.risk_level = parsed.level;
            gr.update();
        }
    }
})(current, previous);]]></script>
